# ---- 班级课表助手 · 环境变量样例（复制为 .env 或导出到 shell 后使用）----

# Flask session 签名密钥。生产环境必填，生成方式：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 运行环境：development / production
# production 下未设置独立 SECRET_KEY 时应用拒绝启动，种子脚本拒绝执行
APP_ENV=development

# SQLite 数据库文件路径（缺省为项目内 instance/classschedule.db）
DATABASE=

# 生产环境（HTTPS）置 1，会话 Cookie 仅经加密连接发送
SESSION_COOKIE_SECURE=0

# 本地直接运行 python app.py 时开启调试（勿用于生产）
FLASK_DEBUG=0
